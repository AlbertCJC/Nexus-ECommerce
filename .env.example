# Supabase Configuration
# Copy these values to Vercel Environment Variables (Project Settings > Environment Variables)
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Service role key for admin operations (NEVER expose to client)
# Only used in server-side scripts, not in the browser
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin email (for initial admin user creation)
VITE_ADMIN_EMAIL=admin@example.com

# Supabase Functions URL (for rate limiting edge function)
VITE_SUPABASE_FUNCTIONS_URL=your_supabase_project_url/functions/v1